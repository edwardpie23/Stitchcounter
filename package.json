{
  "name": "stitchcounter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "web",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=backend && npm run build --workspace=web",
    "backend": "npm run dev --workspace=backend",
    "frontend": "npm run dev --workspace=web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
